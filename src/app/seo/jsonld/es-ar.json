    {
      "@type": "FAQPage",
      "@id": "https://courses.ivana.academy/es-ar/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuánto dura la carrera?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las tecnicaturas duran 9 meses, con un módulo por mes. El Profesorado en arte mix media dura 18 meses. En las carreras con continuación, el Profesorado suma 9 meses más."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué título recibo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El título es del Conservatorio Grassi, con validez internacional."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo accedo a las clases?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las clases son 100% online y están en el campus virtual de Ivana Academy (ivana.academy). Al matricularte recibís el acceso y el link del grupo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo empiezo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La inscripción está abierta todo el año. La fecha de inicio de la cohorte la ves en el calendario de cada carrera."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo me doy de baja?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Podés darte de baja cuando quieras desde \"Mis carreras\" en la tienda. Mientras la tienda no esté disponible, escribinos por WhatsApp. También podés consultar el derecho de arrepentimiento y la política de reembolso."
          }
        },
        {
          "@type": "Question",
          "name": "¿Necesito cuenta de Mercado Pago?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La cuota mensual se gestiona con Mercado Pago. Si tenés dudas sobre cómo pagar, escribinos por WhatsApp y te ayudamos antes de inscribirte."
          }
        },
        {
          "@type": "Question",
          "name": "¿Dónde veo el valor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El valor se muestra en la tienda, cuando elegís la carrera e iniciás tu inscripción."
          }
        }
      ]
