# Variáveis VITE_* são PÚBLICAS: entram no JavaScript entregue aos visitantes. Nunca coloque segredo aqui.
VITE_TURNSTILE_SITE_KEY=
# Para testar com chaves de teste do Cloudflare (sempre passam): 1x00000000000000000000AA

# Só para `npm run dev` (sem prefixo VITE_: ficam no Node do dev server, não vão para o bundle).
# O proxy do Vite envia POST /api/contact para esta URL com o segredo no header X-Webhook-Secret.
# Prefira o webhook de TESTE do n8n, não o de produção.
WEBHOOK_URL=https://n8n.ivana.academy/webhook-test/contact
WEBHOOK_SECRET=
